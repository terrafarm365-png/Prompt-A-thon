# ==============================================================================
# VAULT CONTROL PLANE CONFIGURATION (.env.example)
# Copy this file to .env and configure your local/cluster values.
# ==============================================================================

# Application Settings
APP_NAME=Vault
APP_ENV=development
DEBUG=true

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Metadata Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For local dev without Postgres, aiosqlite can be used: sqlite+aiosqlite:///./vault.db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/vault

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration (Origins permitted to connect to this API)
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# STORAGE NODE ENDPOINTS (DATA PLANE)
# Paste your actual storage-node addresses here.
# For local development, nodes run on ports 9101-9106.
# For remote or containerized deployments, use internal IPs or DNS hostnames:
# e.g., STORAGE_NODE_A_URL=http://node-a.vault.internal:9101
# ==============================================================================
STORAGE_NODE_A_URL=http://localhost:9101
STORAGE_NODE_B_URL=http://localhost:9102
STORAGE_NODE_C_URL=http://localhost:9103
STORAGE_NODE_D_URL=http://localhost:9104
STORAGE_NODE_E_URL=http://localhost:9105
STORAGE_NODE_F_URL=http://localhost:9106

# Storage Node Authentication & Protocol
STORAGE_NODE_SHARED_SECRET=vault-storage-node-internal-secret-token
STORAGE_NODE_TIMEOUT_SECONDS=10

# Erasure Coding Durability Scheme (Reed-Solomon RS(4+2))
# DATA_SHARDS + PARITY_SHARDS must be <= number of available storage nodes.
DATA_SHARDS=4
PARITY_SHARDS=2

# Object & Chunk Parameters
CHUNK_SIZE_MB=64
MAX_UPLOAD_SIZE_MB=10240
HASH_ALGORITHM=sha256

# Cluster Background Worker Intervals & Limits
HEALTH_CHECK_INTERVAL_SECONDS=15
REPAIR_RETRY_LIMIT=3
SCRUB_INTERVAL_HOURS=24

# Logging
LOG_LEVEL=INFO
